{
  "manifest_version": 1,
  "type": "device",
  "name": "HungaroMet",
  "description": {
    "en": "Hungarian weather from HungaroMet open data: station readings and official warnings.",
    "fr": "Météo hongroise des données ouvertes HungaroMet : mesures des stations et alertes officielles.",
    "de": "Ungarisches Wetter aus offenen Daten von HungaroMet: Stationswerte und amtliche Warnungen.",
    "es": "Tiempo de Hungría con los datos abiertos de HungaroMet: estaciones y alertas oficiales."
  },
  "version": "1.0.0",
  "docker_image": "ghcr.io/guim31/gladys-hungaromet:1.0.0",
  "gladys_version": ">=5.3.0",
  "cover_image": "https://raw.githubusercontent.com/guim31/gladys-hungaromet/main/cover.png",
  "categories": ["environment"],
  "countries": ["HU"],
  "transports": ["cloud"],
